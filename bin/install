#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

# shellcheck source=bin/config
. "$repo_root/bin/config"

usage() {
    echo "usage: $0" >&2
    exit 2
}

require_supported_platform() {
    case "$(uname -s)" in
        Darwin)
            ;;
        *)
            acadctl_fail "acadctl has no plugin installer for this platform"
            ;;
    esac
}

configure_paths() {
    source_bundle="$repo_root/out/acadctl.bundle"
    plugin_root=${ACAD_PLUGIN_DIR:-"$HOME/Library/Application Support/Autodesk/ApplicationAddins"}
    plugin_destination="$plugin_root/acadctl.bundle"
    plugin_staging="$plugin_root/.acadctl.bundle.installing.$$"
    plugin_previous="$plugin_root/.acadctl.bundle.previous.$$"

    source_cli="$repo_root/out/acadctl"
    cli_root=${ACADCTL_BIN_DIR:-"$HOME/.local/bin"}
    cli_destination="$cli_root/acadctl"
    cli_staging="$cli_root/.acadctl.installing.$$"
    cli_previous="$cli_root/.acadctl.previous.$$"

    plugin_touched=false
    cli_touched=false
    installation_committed=false
}

preflight() {
    test -d "$source_bundle" ||
        acadctl_fail "plugin not found at $source_bundle; run 'bin/build release'"
    test -x "$source_cli" ||
        acadctl_fail "CLI not found at $source_cli; run 'bin/build release'"
    test -d "$plugin_root" ||
        acadctl_fail "AutoCAD plugin directory not found at $plugin_root"
    test -d "$cli_root" ||
        acadctl_fail "CLI directory not found at $cli_root"
}

restore() {
    restore_destination=$1
    restore_previous=$2
    restore_touched=$3
    restore_type=$4

    if test "$restore_touched" = true; then
        case "$restore_type" in
            directory) rm -rf "$restore_destination" ;;
            file) rm -f "$restore_destination" ;;
        esac
    fi
    if test -e "$restore_previous"; then
        mv "$restore_previous" "$restore_destination"
    fi
}

cleanup() {
    rm -rf "$plugin_staging"
    rm -f "$cli_staging"

    if test "$installation_committed" = true; then
        rm -rf "$plugin_previous"
        rm -f "$cli_previous"
    else
        restore "$plugin_destination" "$plugin_previous" "$plugin_touched" directory
        restore "$cli_destination" "$cli_previous" "$cli_touched" file
    fi
}

install_plugin() {
    ditto "$source_bundle" "$plugin_staging"
    codesign --verify --strict "$plugin_staging/Contents/acadctl-plugin.bundle"

    if test -e "$plugin_destination"; then
        mv "$plugin_destination" "$plugin_previous"
    fi
    plugin_touched=true
    mv "$plugin_staging" "$plugin_destination"
}

install_cli() {
    cp "$source_cli" "$cli_staging"
    chmod 755 "$cli_staging"
    if test -e "$cli_destination"; then
        mv "$cli_destination" "$cli_previous"
    fi
    cli_touched=true
    mv -f "$cli_staging" "$cli_destination"
}

main() {
    test "$#" -eq 0 || usage
    require_supported_platform
    configure_paths
    preflight
    acadctl_trap_cleanup

    install_plugin
    install_cli
    installation_committed=true

    echo "$plugin_destination"
    echo "$cli_destination"
}

main "$@"
