#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
configuration=${1:-dev}

"$repo_root/bin/build" "$configuration"

source_bundle="$repo_root/dist/acadctl.bundle"
install_root=${ACADCTL_APPLICATION_ADDINS_ROOT:-"$HOME/Library/Application Support/Autodesk/ApplicationAddins"}
destination="$install_root/acadctl.bundle"
staging="$install_root/.acadctl.bundle.installing.$$"
previous="$install_root/.acadctl.bundle.previous.$$"

cleanup() {
    if test -e "$previous"; then
        if test -e "$destination"; then
            rm -rf "$previous"
        else
            mv "$previous" "$destination"
        fi
    fi
    if test -e "$staging"; then
        rm -rf "$staging"
    fi
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$install_root"
ditto "$source_bundle" "$staging"
xmllint --noout "$staging/PackageContents.xml"
codesign --verify --strict "$staging/Contents/acadctl-plugin.bundle"

if test -e "$destination"; then
    mv "$destination" "$previous"
fi

mv "$staging" "$destination"

echo "$destination"
