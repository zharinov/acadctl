#!/bin/sh
set -eu

if test "$#" -ne 0; then
    echo "usage: $0" >&2
    exit 2
fi

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fail() {
    echo "$1" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        fail "$1 not found"
}

for command_name in cargo git shellcheck shfmt; do
    require_command "$command_name"
done
cargo deny --version >/dev/null 2>&1 ||
    fail "cargo-deny not found"
cargo shear --version >/dev/null 2>&1 ||
    fail "cargo-shear not found"

log_root=$(mktemp -d "${TMPDIR:-/tmp}/acadctl-ci.XXXXXX")
step_number=0

cleanup() {
    rm -rf -- "$log_root"
}

interrupt() {
    status=$1
    trap - EXIT HUP INT TERM
    cleanup
    echo >&2
    echo "interrupted" >&2
    exit "$status"
}

trap cleanup EXIT
trap 'interrupt 129' HUP
trap 'interrupt 130' INT
trap 'interrupt 143' TERM

run_step() {
    label=$1
    shift
    step_number=$((step_number + 1))
    log="$log_root/$step_number.log"

    printf '%s... ' "$label"

    if "$@" >"$log" 2>&1; then
        echo "ok"
    else
        status=$?
        echo "failed"
        cat "$log"
        exit "$status"
    fi
}

cd "$repo_root"

run_step "diff (worktree)" git diff --check
run_step "diff (index)" git diff --cached --check
run_step "format" bin/fmt --check
run_step "shell" shellcheck \
    bin/build \
    bin/build-macos \
    bin/ci \
    bin/ci-macos \
    bin/config-macos \
    bin/fmt \
    bin/install-plugin \
    bin/install-plugin-macos
run_step "clippy (host)" cargo clippy --quiet \
    --workspace \
    --all-targets \
    --all-features \
    --locked \
    -- \
    -D warnings
run_step "test" cargo test --quiet --workspace --all-targets --all-features --locked
run_step "documentation" env RUSTDOCFLAGS='-D warnings' cargo doc --quiet \
    --workspace \
    --all-features \
    --no-deps \
    --locked
run_step "unused dependencies" cargo shear --locked --deny-warnings
run_step "dependency policy" cargo deny --log-level error check

case "$(uname -s)" in
    Darwin)
        run_step "build and post-checks (macOS)" bin/ci-macos
        ;;
    *)
        fail "acadctl has no CI build for this platform"
        ;;
esac
