#!/bin/sh

acadctl_fail() {
    echo "$1" >&2
    exit 1
}

acadctl_require_command() {
    command -v "$1" >/dev/null 2>&1 || acadctl_fail "$1 not found"
}

acadctl_trap_cleanup() {
    trap cleanup EXIT
    trap 'trap - EXIT HUP INT TERM; cleanup; exit 129' HUP
    trap 'trap - EXIT HUP INT TERM; cleanup; exit 130' INT
    trap 'trap - EXIT HUP INT TERM; cleanup; exit 143' TERM
}

acadctl_configure() {
    case "$(uname -s)" in
        Darwin)
            acadctl_configure_mac
            ;;
        *)
            acadctl_fail "acadctl has no build for this platform"
            ;;
    esac
}

# Variables assigned here are consumed by scripts that source this file.
# shellcheck disable=SC2034
acadctl_configure_mac() {
    acadctl_autocad_root=${ACAD_DIR:-"/Applications/Autodesk/AutoCAD 2027/AutoCAD 2027.app"}
    acadctl_autocad_identifier=$(plutil -extract CFBundleIdentifier raw \
        "$acadctl_autocad_root/Contents/Info.plist" 2>/dev/null || true)
    acadctl_autocad_version=${acadctl_autocad_identifier#com.autodesk.AutoCAD}

    case "$acadctl_autocad_version" in
        '' | *[!0-9]*)
            acadctl_fail "could not determine the AutoCAD release year from $acadctl_autocad_root"
            ;;
    esac

    acadctl_sdk_root=${ACAD_SDK_DIR:-"/Library/Developer/Autodesk/ObjectARX $acadctl_autocad_version"}
    acadctl_atil_include_dir=${ACADCTL_ATIL_INCLUDE_DIR:-}
    acadctl_deployment_target=${MACOSX_DEPLOYMENT_TARGET:-14.0}
    acadctl_arch=${ARCH:-arm64}

    case "$acadctl_arch" in
        arm64)
            acadctl_rust_target=aarch64-apple-darwin
            ;;
        x86_64)
            acadctl_rust_target=x86_64-apple-darwin
            ;;
        *)
            acadctl_fail "unsupported macOS architecture '$acadctl_arch' (expected arm64 or x86_64)"
            ;;
    esac
}

acadctl_check_atil_inputs() {
    test -n "$acadctl_atil_include_dir" || return 0

    for header in Image.h RgbModel.h Size.h; do
        test -f "$acadctl_atil_include_dir/$header" ||
            acadctl_fail "ATIL headers not found at $acadctl_atil_include_dir"
    done

    for library in libAdImaging.dylib libAdIntImgServices.dylib; do
        test -f "$acadctl_autocad_root/Contents/Frameworks/$library" ||
            acadctl_fail "AutoCAD ATIL runtime not found at $acadctl_autocad_root"
    done
}

acadctl_workspace_version() {
    awk '
        /^\[workspace\.package\]$/ { package = 1; next }
        package && /^\[/ { exit }
        package && $1 == "version" {
            gsub(/"/, "", $3)
            print $3
            exit
        }
    ' "$1/Cargo.toml"
}

acadctl_autocad_series() {
    acadctl_autocad_bundle_version=$(plutil -extract CFBundleVersion raw \
        "$acadctl_autocad_root/Contents/Info.plist")
    acadctl_autocad_major=${acadctl_autocad_bundle_version%%.*}

    case "$acadctl_autocad_major" in
        '' | *[!0-9]*)
            acadctl_fail "could not derive the AutoCAD series from CFBundleVersion '$acadctl_autocad_bundle_version'"
            ;;
    esac

    printf 'R%s.0\n' "$acadctl_autocad_major"
}
