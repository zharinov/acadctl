#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

case "$(uname -s)" in
    Darwin)
        exec "$repo_root/bin/build-macos" "$@"
        ;;
    *)
        echo "acadctl has no build for this platform; add a platform build beside bin/build-macos" >&2
        exit 1
        ;;
esac
