#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sdk_root=${OBJECTARX_SDK_ROOT:-/Library/Developer/Autodesk/ObjectARX 2027}
autocad_root=${AUTOCAD_ROOT:-/Applications/Autodesk/AutoCAD 2027/AutoCAD 2027.app}
deployment_target=${MACOSX_DEPLOYMENT_TARGET:-14.0}
rust_target="$repo_root/target/rust-objectarx"
configuration=${1:-}

case "$configuration" in
    dev)
        cargo_profile=debug
        cargo_args="--features acadctl-plugin/dev-reload"
        ;;
    release)
        cargo_profile=release
        cargo_args=--release
        ;;
    *)
        echo "usage: $0 dev|release" >&2
        exit 2
        ;;
esac

build_bundle="$repo_root/target/objectarx/build/$configuration/acadctl.bundle"
build_executable="$build_bundle/Contents/MacOS/acadctl-plugin"
build_payload="$build_bundle/Contents/MacOS/libacadctl_core.dylib"
bundle="$repo_root/target/objectarx/$configuration/acadctl.bundle"
executable="$bundle/Contents/MacOS/acadctl-plugin"
payload="$bundle/Contents/MacOS/libacadctl_core.dylib"
reload_signal="$repo_root/target/objectarx/$configuration/reload"

test -f "$sdk_root/inc/rxregsvc.h" || {
    echo "ObjectARX SDK not found at $sdk_root" >&2
    exit 1
}

test -d "$autocad_root/Contents/Frameworks" || {
    echo "AutoCAD not found at $autocad_root" >&2
    exit 1
}

cd "$repo_root"
MACOSX_DEPLOYMENT_TARGET="$deployment_target" \
    CARGO_TARGET_DIR="$rust_target" \
    cargo build --workspace $cargo_args

mkdir -p "$build_bundle/Contents/MacOS"
mkdir -p "$bundle/Contents/MacOS"
rm -f "$build_bundle/Contents/_CodeSignature/CodeResources"
cp "$repo_root/native/objectarx/Info.plist" "$build_bundle/Contents/Info.plist"

set --
if test "$configuration" = dev; then
    set -- \
        -DACADCTL_DEV_RELOAD \
        "-DACADCTL_RELOAD_SIGNAL_PATH=\"$reload_signal\"" \
        -framework CoreFoundation \
        -framework CoreServices
fi
set -- "$@" "-DACADCTL_PAYLOAD_PATH=\"$payload\""

clang++ \
    -std=c++17 \
    -arch arm64 \
    -mmacosx-version-min="$deployment_target" \
    -bundle \
    "$@" \
    -I"$sdk_root/inc" \
    -I"$repo_root/native/objectarx" \
    -I"$rust_target/cxxbridge" \
    -L"$autocad_root/Contents/Frameworks" \
    -F"$autocad_root/Contents/Frameworks" \
    "$repo_root/native/objectarx/host.cpp" \
    "$rust_target/$cargo_profile/libacadctl_plugin.a" \
    -lacfirst \
    -lacdb \
    -laccore \
    -lAcPal \
    -o "$build_executable"

cp "$rust_target/$cargo_profile/libacadctl_core.dylib" "$build_payload"

plutil -lint "$build_bundle/Contents/Info.plist" >/dev/null
file "$build_executable" | grep -q 'Mach-O 64-bit bundle arm64'
nm -gU "$build_executable" | grep -q ' _acrxEntryPoint$'
nm -gU "$build_payload" | grep -q ' _acadctl_hello_message$'
codesign --force --sign - "$build_bundle"
codesign --verify --strict "$build_bundle"

mkdir -p "$bundle/Contents/_CodeSignature"
mv -f "$build_bundle/Contents/Info.plist" "$bundle/Contents/Info.plist"
mv -f "$build_executable" "$executable"
mv -f "$build_bundle/Contents/_CodeSignature/CodeResources" \
    "$bundle/Contents/_CodeSignature/CodeResources"
mv -f "$build_payload" "$payload"
if test "$configuration" = dev; then
    printf '%s-%s\n' "$(date +%s)" "$$" > "$reload_signal"
fi

echo "$bundle"
