#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

usage() {
    echo "usage: $0 [--check]" >&2
    exit 2
}

require_tools() {
    for command_name in cargo clang-format shfmt; do
        command -v "$command_name" >/dev/null 2>&1 || {
            echo "$command_name not found" >&2
            exit 1
        }
    done
}

format_rust() {
    cargo fmt --all --manifest-path "$repo_root/Cargo.toml"
}

check_rust() {
    cargo fmt --all --manifest-path "$repo_root/Cargo.toml" -- --check
}

format_native() {
    clang-format -i \
        "$repo_root/crates/plugin/native/entry.cpp" \
        "$repo_root/crates/plugin/native/host.cpp" \
        "$repo_root/crates/plugin/native/host.hpp" \
        "$repo_root/crates/rpc/proto/acadctl.proto"
}

check_native() {
    clang-format --dry-run --Werror \
        "$repo_root/crates/plugin/native/entry.cpp" \
        "$repo_root/crates/plugin/native/host.cpp" \
        "$repo_root/crates/plugin/native/host.hpp" \
        "$repo_root/crates/rpc/proto/acadctl.proto"
}

format_shell() {
    shfmt -w -i 4 -ci \
        "$repo_root/bin/build" \
        "$repo_root/bin/ci" \
        "$repo_root/bin/install" \
        "$repo_root/bin/fmt" \
        "$repo_root/bin/config"
}

check_shell() {
    shfmt -d -i 4 -ci \
        "$repo_root/bin/build" \
        "$repo_root/bin/ci" \
        "$repo_root/bin/install" \
        "$repo_root/bin/fmt" \
        "$repo_root/bin/config"
}

main() {
    test "$#" -le 1 || usage
    require_tools

    case "${1:-}" in
        '')
            format_rust
            format_native
            format_shell
            ;;
        --check)
            check_rust
            check_native
            check_shell
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
