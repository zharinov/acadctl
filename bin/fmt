#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

command -v clang-format >/dev/null 2>&1 || {
    echo "clang-format not found" >&2
    exit 1
}

case "${1:-}" in
    "")
        cargo fmt --all --manifest-path "$repo_root/Cargo.toml"
        clang-format -i \
            "$repo_root/crates/plugin/native/entry.cpp" \
            "$repo_root/crates/plugin/native/host.cpp" \
            "$repo_root/crates/plugin/native/host.hpp" \
            "$repo_root/crates/rpc/proto/acadctl.proto"
        shfmt -w -i 4 -ci \
            "$repo_root/bin/build" \
            "$repo_root/bin/build-macos" \
            "$repo_root/bin/ci" \
            "$repo_root/bin/ci-macos" \
            "$repo_root/bin/config-macos" \
            "$repo_root/bin/fmt" \
            "$repo_root/bin/install-plugin" \
            "$repo_root/bin/install-plugin-macos"
        ;;
    --check)
        cargo fmt --all --manifest-path "$repo_root/Cargo.toml" -- --check
        clang-format --dry-run --Werror \
            "$repo_root/crates/plugin/native/entry.cpp" \
            "$repo_root/crates/plugin/native/host.cpp" \
            "$repo_root/crates/plugin/native/host.hpp" \
            "$repo_root/crates/rpc/proto/acadctl.proto"
        shfmt -d -i 4 -ci \
            "$repo_root/bin/build" \
            "$repo_root/bin/build-macos" \
            "$repo_root/bin/ci" \
            "$repo_root/bin/ci-macos" \
            "$repo_root/bin/config-macos" \
            "$repo_root/bin/fmt" \
            "$repo_root/bin/install-plugin" \
            "$repo_root/bin/install-plugin-macos"
        ;;
    *)
        echo "usage: $0 [--check]" >&2
        exit 2
        ;;
esac
