#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
llvm_root=${LLVM_ROOT:-}

if test -z "$llvm_root"; then
    llvm_root=$(brew --prefix llvm@22)
fi

clang_format="$llvm_root/bin/clang-format"

test -x "$clang_format" || {
    echo "clang-format not found under $llvm_root" >&2
    exit 1
}

case "${1:-}" in
    "")
        cargo fmt --all --manifest-path "$repo_root/Cargo.toml"
        "$clang_format" -i \
            "$repo_root/crates/plugin/native/entry.cpp" \
            "$repo_root/crates/plugin/native/host.cpp" \
            "$repo_root/crates/plugin/native/host.hpp" \
            "$repo_root/crates/rpc/proto/acadctl.proto"
        shfmt -w -i 4 -ci "$repo_root/bin"
        ;;
    --check)
        cargo fmt --all --manifest-path "$repo_root/Cargo.toml" -- --check
        "$clang_format" --dry-run --Werror \
            "$repo_root/crates/plugin/native/entry.cpp" \
            "$repo_root/crates/plugin/native/host.cpp" \
            "$repo_root/crates/plugin/native/host.hpp" \
            "$repo_root/crates/rpc/proto/acadctl.proto"
        shfmt -d -i 4 -ci "$repo_root/bin"
        ;;
    *)
        echo "usage: $0 [--check]" >&2
        exit 2
        ;;
esac
