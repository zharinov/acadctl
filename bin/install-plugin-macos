#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

if test "$#" -ne 0; then
    echo "usage: $0" >&2
    exit 2
fi

source_bundle="$repo_root/out/acadctl.bundle"
install_root=${ACAD_PLUGIN_DIR:-"$HOME/Library/Application Support/Autodesk/ApplicationAddins"}
destination="$install_root/acadctl.bundle"
staging="$install_root/.acadctl.bundle.installing.$$"
previous="$install_root/.acadctl.bundle.previous.$$"
bundle_touched=false
committed=false

test -d "$source_bundle" || {
    echo "plugin not found at $source_bundle; run 'bin/build release'" >&2
    exit 1
}

test -d "$install_root" || {
    echo "AutoCAD plugin directory not found at $install_root" >&2
    exit 1
}

cleanup() {
    if test "$committed" = true; then
        rm -rf "$previous"
    else
        if test "$bundle_touched" = true; then
            rm -rf "$destination"
        fi
        if test -e "$previous"; then
            mv "$previous" "$destination"
        fi
    fi
    rm -rf "$staging"
}
trap cleanup EXIT HUP INT TERM

ditto "$source_bundle" "$staging"
codesign --verify --strict "$staging/Contents/acadctl-plugin.bundle"

bundle_touched=true
if test -e "$destination"; then
    mv "$destination" "$previous"
fi
mv "$staging" "$destination"

committed=true
echo "$destination"
